---
import Header from "./servers/Header.astro";

import Minecraft from "./servers/game/Minecraft.astro";
import Ark from "./servers/game/Ark.astro";
import SevenDays from "./servers/game/7dtd.astro";
import Gmod from "./servers/game/Gmod.astro";

import Faq from "../ui/Faq.astro";
---

<section class="flex flex-col gap-4 container mx-auto">
    <Header />
    <div class="flex flex-col gap-4 sm:gap-40">
        <Minecraft />
        <Ark />
        <SevenDays />
        <Gmod />
    </div>
    <div class="p-4">
        <h3 class="font-outfit text-2xl font-bold text-white mb-4">
            Frequently Asked Questions
        </h3>
        <Faq question="How do I connect to the servers?">
            To connect to our servers, simply join our Discord server and
            navigate to the #servers channel. There, you'll find detailed
            instructions on how to connect to each of our game servers,
            including IP addresses, passwords, and any necessary mods or
            plugins.
        </Faq>
    </div>
</section>
