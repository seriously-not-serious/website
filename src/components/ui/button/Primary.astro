---
type Props = {
    url: string;
    newTab?: boolean;
    disabled?: boolean;
};

const { url, newTab = false, disabled = false } = Astro.props as Props;

const className = `inline-flex items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 ${disabled ? "opacity-50 cursor-not-allowed" : ""}`;
---

{
    disabled ? (
        <button class={className} disabled={disabled}>
            <slot />
        </button>
    ) : (
        <a
            href={url}
            target={newTab ? "_blank" : "_self"}
            rel={newTab ? "noopener noreferrer" : undefined}
            class={className}
        >
            <slot />
        </a>
    )
}
